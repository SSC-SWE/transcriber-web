# ---- OpenRouter (required) ----
# One key powers transcription (STT), AI summaries and quiz generation.
# Create one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Chat model for summaries + quizzes (same default as the mac app).
OPENROUTER_MODEL=deepseek/deepseek-chat

# Speech-to-text model. Whisper large-v3 is a safe default (Cantonese/Mandarin/English).
# For long recordings (>~25 MB audio) use google/chirp-3 (long-audio). Cheap Chinese
# alternative: qwen/qwen3-asr-1.7b. See README for the full list.
OPENROUTER_STT_MODEL=openai/whisper-large-v3

# ---- Google Forms quiz (optional) ----
# Leave blank to hide the quiz button. One-time setup in README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" on the Google OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:8787/api/google/callback

# ---- Server ----
PORT=8787
HOST=127.0.0.1
# Where sessions, uploaded audio and the Google token are stored.
DATA_DIR=./data
