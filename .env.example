# ---- OpenRouter (required) ----
# One key powers transcription (STT), AI summaries and quiz generation.
# Create one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Chat model for summaries + quizzes (DeepSeek V4 Pro).
OPENROUTER_MODEL=deepseek/deepseek-v4-pro

# Speech-to-text model. Whisper large-v3-turbo is fast and cheap (Cantonese/Mandarin/English).
# Whisper has a ~25 MB audio limit — split longer recordings into smaller files.
OPENROUTER_STT_MODEL=openai/whisper-large-v3-turbo

# ---- Google Forms quiz (optional) ----
# Leave blank to hide the quiz button. One-time setup in README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" on the Google OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:8787/api/google/callback

# ---- Server ----
PORT=8787
HOST=127.0.0.1
# Where sessions, uploaded audio and the Google token are stored.
DATA_DIR=./data
